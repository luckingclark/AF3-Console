flowchart TB
    accTitle: Run Pulldown 和 Scan 模式总览
    accDescr: 三种模式分别准备指定任务、两组组合或片段组合，随后复用或准备 MSA，进行 GPU 预测并汇总结果。Scan 包含固定窗口和 PAE 引导两种方式。
    inputs["输入蛋白或复合物"] --> run["Run<br/>预测指定输入"]
    inputs --> pulldown["Pulldown<br/>两组输入组合筛选"]
    inputs --> scan["Scan<br/>片段扫描"]
    scan --> window_scan["固定窗口<br/>长度与重叠"]
    scan --> pae_scan["PAE 引导<br/>结构域窗口"]
    run --> prepare_msa["MSA<br/>复用或计算"]
    pulldown --> prepare_msa
    window_scan --> prepare_msa
    pae_scan --> prepare_msa
    prepare_msa --> predict["GPU 预测<br/>生成结构"]
    predict --> results(["结果<br/>结构、置信度与汇总"])
